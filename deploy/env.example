# assistant-bot configuration — every key is required; the bot refuses to
# start if one is missing.
#
# Copy to /home/ubuntu/.config/assistant-bot/env on the VM and set mode 600:
#   mkdir -p ~/.config/assistant-bot && chmod 700 ~/.config/assistant-bot
#   $EDITOR ~/.config/assistant-bot/env && chmod 600 ~/.config/assistant-bot/env
#
# Never commit the real env file: DISCORD_TOKEN and HEALTHCHECK_URL are secrets.

# Bot token from Discord Developer Portal → your app → Bot → Reset Token.
DISCORD_TOKEN=

# Khang's private server ID (Developer Mode → right-click server → Copy Server ID).
DISCORD_GUILD_ID=

# The #server channel ID (right-click channel → Copy Channel ID). Alerts land here.
DISCORD_CHANNEL_ID=

# Khang's Discord user ID (right-click own name → Copy User ID).
# The bot answers slash commands only for this user.
OWNER_USER_ID=

# healthchecks.io ping URL, e.g. https://hc-ping.com/<uuid> (secret).
# Create the check FIRST: period 5 min, grace 10 min, Discord + email integrations.
HEALTHCHECK_URL=
